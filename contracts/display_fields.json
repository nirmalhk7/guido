{
  "_how_to_edit": "This is the ONE place for what the audit-trail page shows and how it's worded. To hide a data point, delete its entry or set \"show\": false. To reorder, move the entry up or down in its list. To rename, change \"label\". \"field\" must match a field name in trip_result.schema.json; dots mean a field inside another one (e.g. travel_to_branch.minutes). \"format\" tells the page how to display the value: text, currency, minutes, datetime, date, number, list, mileage, yes_no.",

  "status_labels": {
    "recommended": "Best match",
    "alternative": "Also a good option",
    "not_a_fit": "Doesn't fit your trip"
  },

  "handoff_labels": {
    "rental_company_checkout": "Finish booking on the rental company's site",
    "simulated_booking": "Demo booking (simulated, nothing was paid)"
  },

  "mileage_labels": {
    "unlimited": "Unlimited miles",
    "capped": "{cap_miles} miles included, then {per_mile_cost} per mile"
  },

  "data_source": {
