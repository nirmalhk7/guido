    "picker_label": "What matters most?",
    "options": [
      {
        "key": "lowest_total_cost",
        "label": "Lowest total cost",
        "recommended_because": "Recommended because it has the lowest total cost, your current priority."
      },
      {
        "key": "closest_pickup",
        "label": "Closest pickup",
        "recommended_because": "Recommended because it's the quickest to get to, your current priority."
      },
      {
        "key": "most_flexible_cancellation",
        "label": "Most flexible cancellation",
        "recommended_because": "Recommended because it's the easiest to cancel, your current priority."
      }
    ],
    "changed_note": "You changed what matters most to {priority_label}. The recommendation updated."
  },

